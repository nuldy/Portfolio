---
/**
 * Light/dark switch. A toggle button: aria-pressed="true" means dark mode is on.
 * Hidden when scripting is off, because it can't do anything then; the page
 * follows the system theme instead.
 */
---

<button type="button" class="theme-toggle" aria-pressed="false" data-theme-toggle>
  <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
  </svg>
  <span class="visually-hidden">Dark mode</span>
</button>

<script>
  import '../scripts/theme';
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: calc(-1 * var(--space-3));
    padding: 0;
    border: 0;
    border-radius: var(--radius-max);
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle svg {
    transition: transform var(--dur-2) var(--ease-in-out);
  }

  .theme-toggle[aria-pressed='true'] svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      transition: none;
    }
  }

  @media (scripting: none) {
    .theme-toggle {
      display: none;
    }
  }
</style>
